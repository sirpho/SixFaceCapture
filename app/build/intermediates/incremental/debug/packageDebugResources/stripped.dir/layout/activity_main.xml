<?xml version="1.0" encoding="utf-8"?>
<!-- 主拍摄页：全屏相机预览+ 十字准星 + 快门 + 6方向进度条-->
<FrameLayout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:ignore="ExtraText">

    <!-- 1. 相机预览 View -->
    <TextureView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. 十字准星叠加层 -->
    <com.vrpanorama.app.ui.CrosshairView
        android:id="@+id/crosshairView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 3. 当前方向提示文字 -->
    <TextView
        android:id="@+id/tvDirectionHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="16dp"
        android:text="请对准前方开始拍摄"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:background="#66000000"
        android:padding="8dp" />

    <!-- 4. 6方向进度缩略图（顶部横向排列）-->
    <LinearLayout
        android:id="@+id/directionBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:layout_marginTop="56dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#66000000"
        android:padding="4dp">
    </LinearLayout>

    <!-- 5. 底部按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="24dp"
        android:background="#66000000">

        <Button
            android:id="@+id/btnShoot"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="@string/btn_shoot"
            android:textSize="16sp"
            android:background="@drawable/btn_circle" />

        <Button
            android:id="@+id/btnStitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="@string/btn_stitch"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>